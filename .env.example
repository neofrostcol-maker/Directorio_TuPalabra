# Base de datos libSQL / Turso
# En desarrollo local se utiliza automáticamente 'file:./dev.db' si no se configuran estas variables.
# En producción (Vercel), crea una base de datos en Turso (https://turso.tech) y coloca:
TURSO_DATABASE_URL="libsql://tu-base-de-datos.turso.io"
TURSO_AUTH_TOKEN="tu-token-de-turso"

# Almacenamiento de imágenes con Vercel Blob
# En Vercel: se genera automáticamente al activar Blob en el Dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Seguridad y Autenticación Admin
# Genera un secreto aleatorio para firmar las cookies JWT (mínimo 32 caracteres)
JWT_SECRET="clave-secreta-super-segura-iglesia-tu-palabra-2026-min-32-caracteres"

# Credenciales iniciales del Administrador Único (usadas por el script npm run db:seed)
ADMIN_USER="AdminTuPalabra"
ADMIN_PASSWORD="Iglesia2026+"
ADMIN_EMAIL="jhocamolu2010@gmail.com"

# Notificaciones por correo electrónico (Opcional - Resend)
# Si no se configura, los correos se registran informativamente en consola.
RESEND_API_KEY=""

# Protección Anti-Spam Cloudflare Turnstile (Opcional)
# Si se configuran, se valida el captcha en el formulario de registro.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# URL pública de la aplicación
APP_URL="http://localhost:3000"
