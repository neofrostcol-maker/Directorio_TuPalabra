# ==============================================================================
# Directorio Empresarial Tu Palabra - Variables de Entorno
# ==============================================================================
# MODO DEMO VERCEL (Zero-Config):
# Puedes desplegar directamente en Vercel SIN configurar Turso ni Vercel Blob.
# La aplicación inicializará automáticamente una base SQLite temporal (/tmp/dev.db)
# con las 23 categorías oficiales, el administrador y negocios de demostración.
#
# MODO PRODUCCIÓN PERSISTENTE:
# Configura Turso (libSQL) y Vercel Blob para persistencia permanente en la nube.
# ==============================================================================

# Base de datos libSQL / Turso (Opcional en Demo)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Almacenamiento de imágenes con Vercel Blob (Opcional en Demo)
# En Vercel: se genera automáticamente al activar Storage -> Blob.
BLOB_READ_WRITE_TOKEN=""

# Seguridad y Autenticación Admin
# Cambia este secreto en producción (mínimo 32 caracteres aleatorios)
JWT_SECRET="clave-secreta-super-segura-iglesia-tu-palabra-2026-min-32-caracteres"

# Credenciales iniciales del Administrador Único
ADMIN_USER="AdminTuPalabra"
ADMIN_PASSWORD="Iglesia2026+"
ADMIN_EMAIL="jhocamolu2010@gmail.com"

# Notificaciones por correo electrónico (Opcional - Resend)
# Si no se configura, los correos se registran en los logs del servidor.
RESEND_API_KEY=""

# Protección Anti-Spam Cloudflare Turnstile (Opcional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# URL pública de la aplicación
# En Vercel se detecta automáticamente vía VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# Déjala vacía en Vercel o coloca tu dominio personalizado (ej. https://directorio.tupalabra.org).
APP_URL=""
